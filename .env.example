# Public identifiers (not secrets). Leave the project ID empty to keep local fallbacks.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: read-only Viewer token for a private dataset. Never use NEXT_PUBLIC_ here.
# A public dataset does not need a token. Studio uses your Sanity account login.
SANITY_API_READ_TOKEN=
